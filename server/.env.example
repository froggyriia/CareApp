# Copy to .env and fill in your TEST keys (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Printed by `npm run webhooks` (stripe listen)
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform cut, in percent
PLATFORM_FEE_PERCENT=10
CURRENCY=eur
# Country of caregiver accounts (must be supported for transfers from your platform)
CONNECT_COUNTRY=MT
# Your Mac's LAN IP so the phone can reach the server, e.g. http://192.168.1.20:4242
BASE_URL=http://localhost:4242
